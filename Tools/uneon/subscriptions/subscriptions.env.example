# VPS only. Use an absolute SQLite path shared by service and linking bot.
UNEON_DB=/var/lib/uneon-subscriptions/links.db
UNEON_TIERS_FILE=/etc/uneon-subscriptions/tiers.json
UNEON_API_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Production: provide LoadCredential=discord_token:... in systemd instead.
# DISCORD_TOKEN=FOR_LOCAL_DEVELOPMENT_ONLY
DISCORD_GUILD_ID=REPLACE_WITH_GUILD_ID
UNEON_PORT=8787
